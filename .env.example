# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : uniquement côté serveur (webhook Stripe, API). Ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiants des deux prix créés dans Stripe (4,99 €/mois et 34,99 €/an)
STRIPE_PRICE_MENSUEL=price_...
STRIPE_PRICE_ANNUEL=price_...

# --- Application ---
# URL publique, utilisée pour les redirections Stripe et les liens magiques
NEXT_PUBLIC_SITE_URL=https://lucide.vercel.app

# --- Rappels (notifications Web Push) ---
# Générer une paire de clés : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par les services de notification (mailto: ou URL du site)
VAPID_SUBJECT=mailto:ton-adresse@exemple.fr
# Secret protégeant l'envoi quotidien (Vercel Cron l'envoie automatiquement)
CRON_SECRET=

# --- Application Android (Google Play Store) ---
# Fournis par PWABuilder lors de la création du paquet Android
ANDROID_PACKAGE_NAME=
# Une ou plusieurs empreintes SHA-256, séparées par des virgules
ANDROID_SHA256_FINGERPRINTS=
