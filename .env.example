# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : uniquement côté serveur (webhook Stripe, API). Ne jamais l'exposer.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Identifiants des deux prix créés dans Stripe (4,99 €/mois et 34,99 €/an)
STRIPE_PRICE_MENSUEL=price_...
STRIPE_PRICE_ANNUEL=price_...

# --- Application ---
# URL publique, utilisée pour les redirections Stripe et les liens magiques
NEXT_PUBLIC_SITE_URL=https://lucide.vercel.app
